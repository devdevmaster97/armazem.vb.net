            dr_bso = ds_bso.Tables("OPERACAO_COBRANCA").Select("ID_OPERACAO = " & DGVServicos.Rows(e.RowIndex).Cells(0).Value & " AND ID_COBRANCA = " & DGVServicos.Rows(e.RowIndex).Cells(1).Value & "") 'BUSCA A ENTRADA
            If dr_bso.Length > 0 Then
                DGVServicos.Rows(e.RowIndex).Cells(4).Value = dr_bso(0)("ID_OPER_COB")
                DGVServicos.Rows(e.RowIndex).Cells(5).Value = Now.Date 'DATA RETIRADA
                DGVServicos.Rows(e.RowIndex).Cells(6).Value = StrHora 'HORA RETIRADA
                DGVServicos.Rows(e.RowIndex).Cells(7).Value = DBNull.Value 'DATA RETIRADA
                DGVServicos.Rows(e.RowIndex).Cells(8).Value = StrHora 'HORA RETIRADA
                DGVServicos.Rows(e.RowIndex).Cells(10).Value = dr_bso(0)("VALOR")
                If Not DGVServicos.Rows(e.RowIndex).Cells(9).Value Is DBNull.Value And Not DGVServicos.Rows(e.RowIndex).Cells(10).Value Is DBNull.Value Then
                    DGVServicos.Rows(e.RowIndex).Cells(11).Value = DGVServicos.Rows(e.RowIndex).Cells(9).Value * DGVServicos.Rows(e.RowIndex).Cells(10).Value 'HORA RETIRADA
                End If
                DGVServicos.Rows(e.RowIndex).Cells(14).Value = codigo_depositante
                DGVServicos.Rows(e.RowIndex).Cells(15).Value = ""
                DGVServicos.Rows(e.RowIndex).Cells(16).Value = ""
                DGVServicos.Rows(e.RowIndex).Cells(17).Value = mskOR.Text
            Else
                MsgBox("ESTE SERVIÇO NÃO ESTA DEFINICO")
            End If
        End If
    End Sub

End Class