            registro = 0
            For registro = 0 To DGVLotes.Rows.Count - 2
                dr_lotes = dsi.Tables(0).Select("ID_RETIRADA = 9999999")
                If dr_lotes.Length > 0 Then
                    dr_lotes(0).BeginEdit()
                    dr_lotes(0)(3) = id_retirada ' indice da coluna id_retirada
                    dr_lotes(0).EndEdit()
                End If
            Next
            'ATUALIZA DATASET RETIRADA_LOTES
            Dim cb As New OleDbCommandBuilder(dai)
            dai.Update(dsi, "RETIRADA_LOTES")
            dsi.AcceptChanges()
            '*************ATUALIZA A COLUNA id_retirada DO GRID CAMINHOES COM O NOVO ID**************
            registro = 0
            For registro = 0 To DGVCaminhoes.Rows.Count - 2
                dr_camin = ds_camin.Tables(0).Select("ID_RETIRADA = 9999999")
                If dr_camin.Length > 0 Then
                    dr_camin(0).BeginEdit()
                    dr_camin(0)(2) = id_retirada
                    dr_camin(0).EndEdit()
                End If
            Next
            'ATUALIZA DATASET RETIRADA_CAMINHOES
            Dim cbn As New OleDbCommandBuilder(da_camin)
            da_camin.Update(ds_camin, "RETIRADA_CAMINHOES")
            ds_camin.AcceptChanges()
            '******************* ATUALIZA A COLUNA ID_ENTRADA DO GRID SACARIA COM O NOVO ID*******************
            registro = 0
            For registro = 0 To DGVSacaria.Rows.Count - 2
                dri = dssc1.Tables(0).Select("ID_RETIRADA = 9999999")
                If dri.Length > 0 Then
                    dri(0).BeginEdit()
                    dri(0)(2) = id_retirada
                    dri(0).EndEdit()
                End If
            Next
            'ATUALIZA DATASET SACARIA_RETIRADA
            Dim cbsc As New OleDbCommandBuilder(dasc1)
            dasc1.Update(dssc1, "SACARIA_RETIRADA")
            dssc1.AcceptChanges()
            '******************* ATUALIZA A COLUNA ID_ENTRADA DO GRID SERVICO_OPERACAO COM O NOVO ID*********
            If cadastrando = True Then
                registro = 0
                For registro = 0 To DGVServicos.Rows.Count - 2
                    dr_ser_oper = ds_ser_oper.Tables(0).Select("O_R = '9999999'")
                    If dr_ser_oper.Length > 0 Then
                        dr_ser_oper(0).BeginEdit()
                        dr_ser_oper(0)(15) = mskOR.Text
                        dr_ser_oper(0).EndEdit()
                    End If
                Next
            End If
            'ATUALIZA DATASET SERVICO_OPERACAO
            Dim cbop As New OleDbCommandBuilder(da_ser_oper)
            da_ser_oper.Update(ds_ser_oper, "SERVICO_OPERACAO")
            ds_ser_oper.AcceptChanges()
            '********* PREENCHE O DATASET DO GRID SERVICO_OPERACAO *******************************************
            If DGVServicos.Rows.Count > 0 Then ds_ser_oper.Tables(0).Clear()
            sql(0) = "SELECT * FROM SERVICO_OPERACAO WHERE O_R = '" & mskOR.Text & "'"
            Dim cm_op As New OleDbCommand(sql(0), cn)
            da_ser_oper = New OleDbDataAdapter(cm_op)
            da_ser_oper.Fill(ds_ser_oper, "SERVICO_OPERACAO")
            For registro = 0 To DGVServicos.Rows.Count - 2
                dr_ser_oper = ds_ser_oper.Tables(0).Select("O_R = '" & mskOR.Text & "'")
                If dr_ser_oper.Length > 0 Then
                    sql(0) = "SELECT * FROM qOPERACAO_COBRANCA"
                    Dim cmop As New OleDbCommand(sql(0), cn)
                    da_oper_cob = New OleDbDataAdapter(cmop)
                    da_oper_cob.Fill(ds_oper_cob, "qOPERACAO_COBRANCA")
                    dr_oper_cob = ds_oper_cob.Tables(0).Select("ID_OPER_COB = " & dr_ser_oper(registro)(2) & " ")
                    If dr_oper_cob.Length > 0 Then
                        'BUSCA ID OPERACAO
                        sql(0) = "SELECT * FROM OPERACAO"
                        Dim cmope As New OleDbCommand(sql(0), cn)
                        da_operX = New OleDbDataAdapter(cmope)
                        da_operX.Fill(ds_operX, "OPERACAO")
                        dr_operX = ds_operX.Tables(0).Select("DESCRI = '" & dr_oper_cob(registro)(1) & "'")
                        DGVServicos.Rows(registro).Cells(0).Value = dr_operX(0)("ID_OPERACAO")

                        'BUSCA ID COBRANCA
                        sql(0) = "SELECT * FROM COBRANCA"
                        Dim cmco As New OleDbCommand(sql(0), cn)
                        da_cobX = New OleDbDataAdapter(cmco)
                        da_cobX.Fill(ds_cobX, "COBRANCA")
                        dr_cobX = ds_cobX.Tables(0).Select("DESCRI = '" & dr_oper_cob(registro)(2) & "'")
                        DGVServicos.Rows(registro).Cells(1).Value = dr_cobX(0)("ID_COBRANCA")
                    End If
                End If
            Next
            '******************* RECALCULA TOTAIS ***************************************************
            lblTotalSacas.Text = dsi.Tables(0).Compute("SUM(SACAS)", String.Empty).ToString
            lblTotalPeso.Text = dsi.Tables(0).Compute("SUM(PESO)", String.Empty).ToString
            lblTotalPesoCaminhoes.Text = ds_camin.Tables(0).Compute("SUM(PESO)", String.Empty).ToString
            If altera = True Then
                MsgBox(tabela_db & " alterado com sucesso!", MsgBoxStyle.Information, fabricante)
            Else
                MsgBox(tabela_db & " cadastrado com sucesso!", MsgBoxStyle.Information, fabricante)
            End If
        End If
        altera = True
        habilita(Me, False)
        estadobotao("exibido")
        cadastrando = False
        Cursor.Current = Cursors.Default
    End Sub
