    Private Sub cmdExcluir_Click(ByVal sender As System.Object, ByVal e As System.EventArgs) Handles CmdExcluir.Click
        Dim resp As String
        resp = MsgBox("Deseja realmente excluir esse registro?", MsgBoxStyle.YesNo)
        If resp = vbYes Then
            'EXCLUI DA TAB RETIRADA
            dr = ds.Tables(tabela_db).Select("ID_RETIRADA = " & CriterioBusca)(0)
            dr.Delete()
            Dim cmb As New OleDbCommandBuilder(da)
            da.Update(ds, tabela_db)
            'EXCLUI DA TAB RETIRADA_LOTES
            If DGVLotes.RowCount > 1 Then
                dr = dsi.Tables("RETIRADA_LOTES").Select("ID_RETIRADA = " & CriterioBusca)(0)
                dr.Delete()
                cmb = New OleDbCommandBuilder(dai)
                dai.Update(dsi, "RETIRADA_LOTES")
            End If
            'EXCLUI DA TAB RETIRADA_CAMINHOES
            If DGVCaminhoes.RowCount > 1 Then
                dr = dsi.Tables("RETIRADA_CAMINHOES").Select("ID_RETIRADA = " & CriterioBusca)(0)
                dr.Delete()
                cmb = New OleDbCommandBuilder(da_camin)
                da_camin.Update(ds_camin, "RETIRADA_CAMINHOES")
            End If
            'EXCLUI DA TAB SACARIA_ENTRADA
            If DGVSacaria.RowCount > 1 Then
                dr = dssc1.Tables("SACARIA_RETIRADA").Select("ID_RETIRADA = " & CriterioBusca)(0)
                dr.Delete()
                cmb = New OleDbCommandBuilder(dasc1)
                dasc1.Update(dssc1, "SACARIA_RETIRADA")
            End If
            'EXCLUI DA TAB SERVICO_OPERACAO
            resp = MsgBox("Deseja excluir as cobranças?", MsgBoxStyle.YesNo)
            If resp = vbYes Then
                If DGVServicos.RowCount > 1 Then
                    dr = dssc1.Tables("SERVICO_OPERACAO").Select("O_R = '" & CriterioBusca & "'")(0)
                    dr.Delete()
                    cmb = New OleDbCommandBuilder(da_ser_oper)
