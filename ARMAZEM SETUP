        estadobotao("incluir/Salvar")
        cmdBuscaDepositante.Focus()
        altera = False
        Dim bm As BindingManagerBase

        bm = BindingContext(ds, tabela_db)
        If bm.Count = 0 Then
            mskOR.Text = "0001" & "/" & Mid(Year(Today), 3, 2)
        Else
            bm.Position = bm.Count - 1
            Dim x1 As Int32 = Mid(ds.Tables(0).Rows(bm.Position).Item("RE").ToString(), 1, 4)
            Dim x2 As String = x1 + 1
            If x2.Length = 1 Then
                mskOR.Text = "000" & x2 & "/" & Mid(Year(Today), 3, 2)
            ElseIf x2.Length = 2 Then
                mskOR.Text = "00" & x2 & "/" & Mid(Year(Today), 3, 2)
